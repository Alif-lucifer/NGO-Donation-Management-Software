<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="alif.ngodonationmanagementsoftware.NewCompanyController"
            prefHeight="400.0" prefWidth="600.0">
    <Label text="New Company Registration" layoutX="70" layoutY="20" style="-fx-font-size: 20px; -fx-text-fill: #2c3e50;" />

    <Label text="Name:" layoutX="50" layoutY="80"/>
    <TextField fx:id="nameField" layoutX="150" layoutY="75" prefWidth="200"/>

    <Label text="Email:" layoutX="50" layoutY="130"/>
    <TextField fx:id="emailField" layoutX="150" layoutY="125" prefWidth="200"/>

    <Label text="Password:" layoutX="50" layoutY="180"/>
    <PasswordField fx:id="passwordField" layoutX="150" layoutY="175" prefWidth="200"/>

    <Label text="Confirm Password:" layoutX="50" layoutY="230"/>
    <PasswordField fx:id="confirmPasswordField" layoutX="150" layoutY="225" prefWidth="200"/>

    <Label text="Address:" layoutX="50" layoutY="280"/>
    <TextField fx:id="addressField" layoutX="150" layoutY="275" prefWidth="200"/>

    <Label text="Phone:" layoutX="50" layoutY="330"/>
    <TextField fx:id="phoneField" layoutX="150" layoutY="325" prefWidth="200"/>

    <Label text="Company Type:" layoutX="50" layoutY="380"/>
    <TextField fx:id="typeField" layoutX="150" layoutY="375" prefWidth="200"/>

    <Button fx:id="submitButton" text="Submit" layoutX="100" layoutY="450"
            style="-fx-background-color: #3498db; -fx-text-fill: white;" onAction="#submitButton"/>
    <Button fx:id="backButton" text="Back" layoutX="220" layoutY="450"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white;" onAction="#backButton"/>


</AnchorPane>
