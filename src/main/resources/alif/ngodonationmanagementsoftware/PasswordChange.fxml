<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="alif.ngodonationmanagementsoftware.PasswordChangeController"
            prefWidth="400" prefHeight="300">

    <children>
        <Label text="Password Change" layoutX="120" layoutY="20" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Name:" layoutX="50" layoutY="70"/>
        <!-- Label to show company name dynamically, blank at first -->
        <Label fx:id="nameLabel" layoutX="150" layoutY="70" prefWidth="200" style="-fx-border-color: lightgray; -fx-padding: 3px;"/>

        <Label text="New Password:" layoutX="50" layoutY="110"/>
        <PasswordField fx:id="newPasswordField" layoutX="150" layoutY="105" prefWidth="200"/>

        <Label text="Confirm Password:" layoutX="50" layoutY="150"/>
        <PasswordField fx:id="confirmPasswordField" layoutX="150" layoutY="145" prefWidth="200"/>

        <Button text="Change Password" layoutX="50" layoutY="200" prefWidth="140" onAction="#changePassword"/>
        <Button text="Back" layoutX="210" layoutY="200" prefWidth="140" onAction="#backToDashboard"/>
    </children>

</AnchorPane>
