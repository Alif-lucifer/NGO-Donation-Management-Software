<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alif.ngodonationmanagementsoftware.NonDonatingCompaniesController">
    <Label layoutX="20" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Companies Not Donated" />

    <TableView fx:id="tableView" layoutX="20" layoutY="60" prefHeight="350" prefWidth="660">
        <columns>
            <TableColumn fx:id="companyColumn" prefWidth="200" text="Company Name" />
            <TableColumn fx:id="emailColumn" prefWidth="150" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="150" text="Phone" />
            <TableColumn fx:id="typeColumn" prefWidth="150" text="Type" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <Button layoutX="150" layoutY="430" onAction="#showList" prefWidth="150" text="Show List" />
    <Button layoutX="400" layoutY="430" onAction="#downloadList" prefWidth="150" text="Download List" />
   <Button layoutX="601.0" layoutY="8.0" mnemonicParsing="false" onAction="#backToDashboard" prefHeight="25.0" prefWidth="52.0" text="Back" />
</AnchorPane>
