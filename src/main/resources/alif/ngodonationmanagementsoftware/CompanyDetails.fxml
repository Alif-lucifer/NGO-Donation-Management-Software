<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alif.ngodonationmanagementsoftware.CompanyDetailsController">

    <Label layoutX="14.0" layoutY="14.0" prefHeight="40.0" prefWidth="200.0" text="Company Details">
        <font>
            <Font name="System Bold Italic" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tableView" layoutY="60.0" prefHeight="300.0" prefWidth="620.0">
        <columns>
            <TableColumn fx:id="nameColumn" text="Company Name" />
            <TableColumn fx:id="emailColumn" text="Email" />
            <TableColumn fx:id="phoneColumn" text="Phone" />
            <TableColumn fx:id="typeColumn" text="Type" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Button layoutX="150.0" layoutY="380.0" mnemonicParsing="false"
            text="Show" onAction="#showButtonClicked" />

    <Button layoutX="350.0" layoutY="380.0" mnemonicParsing="false"
            text="Download" onAction="#downloadButtonClicked" />

    <Button layoutX="560.0" layoutY="15.0" mnemonicParsing="false"
            text="Back" onAction="#backButton" />

</AnchorPane>
