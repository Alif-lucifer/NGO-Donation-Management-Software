<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alif.ngodonationmanagementsoftware.CompanyDetailsController">
    <TableView fx:id="tableView" layoutY="90.0" prefHeight="308.0" prefWidth="645.0">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="150" text="Company Name" />
            <TableColumn fx:id="emailColumn" prefWidth="150" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="150" text="Phone" />
            <TableColumn fx:id="typeColumn" prefWidth="150" text="Type" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <Button layoutX="148.0" layoutY="407.0" onAction="#showButtonClicked" text="Show" />
    <Button layoutX="366.0" layoutY="407.0" onAction="#downloadButtonClicked" text="Download" />
   <Label layoutX="14.0" layoutY="28.0" prefHeight="40.0" prefWidth="157.0" text="Company Details">
      <font>
         <Font name="System Bold Italic" size="18.0" />
      </font>
   </Label>
   <Button layoutX="569.0" layoutY="35.0" mnemonicParsing="false" onAction="#backButton" text="Back" />

</AnchorPane>
